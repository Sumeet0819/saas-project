# ==========================================
# Backend Environment Variables (Express)
# ==========================================

# Server Port (default: 5000)
PORT=5000

# Supabase Project Configuration
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (used for auth sign-in and public access)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (secret key with admin privileges to bypass RLS)
# WARNING: Keep this secret! Never expose this on the client-side.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
